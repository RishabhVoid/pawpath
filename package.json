{
  "name": "pawpath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts --host 0.0.0.0",
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/core.test.ts test/browser-host.test.ts",
    "test:production": "node --import tsx --test test/production.test.ts",
    "check:release": "pnpm typecheck && pnpm test && pnpm build && pnpm test:production",
    "bridge": "node --import tsx scripts/laptop.ts",
    "bridge:built": "node dist-server/scripts/laptop.js",
    "indexes": "node --import tsx scripts/indexes.ts",
    "warmup": "node --import tsx scripts/warmup.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "express": "^5.3.0",
    "lucide-react": "^1.54.0",
    "mongodb": "^7.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "light-my-request": "^6.8.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
